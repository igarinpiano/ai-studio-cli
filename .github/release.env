# Project settings for the release workflows (.github/workflows/*.yml).
# Everything that differs from one project to the next lives here; the
# workflows read it.
#
# Format: KEY=value, one per line, no quotes — the value is everything after
# the first "=" (it is appended to $GITHUB_ENV as it is). Lines that do not
# start with KEY= are ignored.

# Name of the executable the release ships (the [[bin]] name, without .exe).
BIN=aistudio
# Cargo package that builds it (cargo build -p ...).
BIN_PACKAGE=aistudio
# Name in the GitHub Release title: "<DISPLAY_NAME> v1.2.3".
DISPLAY_NAME=AI Studio CLI
